# MySQL connection (cPanel: usually created under "MySQL Databases", host is often "localhost")
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret key the CRM (or any polling client) must send as the `x-api-key` header
# when calling GET /api/appointments. Generate a long random string.
APPOINTMENTS_API_KEY=

# Optional: outbound webhook the site POSTs each new appointment to immediately.
# Leave blank to skip outbound push and rely on the CRM polling GET /api/appointments instead.
CRM_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <value>" on the webhook request, if your CRM expects it.
CRM_WEBHOOK_SECRET=

# Admin panel (/admin-login) — signs the login session cookie. Generate a long
# random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
# and never reuse it across environments.
ADMIN_SESSION_SECRET=

# Where uploaded doctor photos are stored. Must be an ABSOLUTE path outside of
# .next (that folder is deleted and rebuilt on every `npm run build`, which
# would wipe uploaded photos otherwise). Defaults to ./uploads for local dev.
# On cPanel, set this to something like /home/yourusername/jbmedical/uploads
UPLOADS_DIR=
