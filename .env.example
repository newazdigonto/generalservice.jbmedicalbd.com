# MySQL connection (cPanel: usually created under "MySQL Databases", host is often "localhost")
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret key the CRM (or any polling client) must send as the `x-api-key` header
# when calling GET /api/appointments. Generate a long random string.
APPOINTMENTS_API_KEY=

# Optional: outbound webhook the site POSTs each new appointment to immediately.
# Leave blank to skip outbound push and rely on the CRM polling GET /api/appointments instead.
CRM_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <value>" on the webhook request, if your CRM expects it.
CRM_WEBHOOK_SECRET=
